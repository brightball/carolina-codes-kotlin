#!/usr/bin/env bash
# In-repo pre-commit entry. Prefer the pre-commit runner so named hooks
# match .pre-commit-config.yaml; fall back to the same Gradle/gitleaks commands.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
export PATH="${HOME}/.local/bin:${PATH}"
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash --shims)"
fi
if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --hook-stage pre-commit --all-files
fi
./gradlew --no-daemon test
./gradlew --no-daemon detekt
./gradlew --no-daemon osvScan
gitleaks detect --source . --verbose
./gradlew --no-daemon ktlintCheck
